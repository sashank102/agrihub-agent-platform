OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GROQ_API_KEY=
GOOGLE_API_KEY=
TAVILY_API_KEY=

# Local PostgreSQL development only. Replace all values in deployed
# environments and provide DATABASE_URI through the deployment secret store.
POSTGRES_DB=agent_platform
POSTGRES_USER=agent_platform
POSTGRES_PASSWORD=agent_platform
POSTGRES_PORT=5432
DATABASE_URI=postgresql://agent_platform:agent_platform@localhost:5432/agent_platform

# Unauthenticated local-development FastAPI server. Keep API_HOST loopback-only.
API_HOST=127.0.0.1
API_PORT=8000
API_ALLOWED_ORIGINS=["http://127.0.0.1:3000"]
API_MAX_REQUEST_BODY_BYTES=10485760
API_MAX_CONCURRENT_RUNS=4
DEVELOPMENT_USER_ID=00000000-0000-4000-8000-000000000001
DEVELOPMENT_USER_EMAIL=developer@agrihub.local
DEVELOPMENT_AGENT_ID=00000000-0000-4000-8000-000000000002
DEVELOPMENT_GRAPH_ID=agrihub

# Use any provider supported by LangChain's init_chat_model. Provider-specific
# model variables may still override individual agent roles when needed.
MODEL=anthropic:claude-sonnet-4-20250514
SEARCH_API=anthropic