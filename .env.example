OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
TAVILY_API_KEY=
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=
LANGSMITH_TRACING=false

# AgriHub defaults use only Anthropic. Override these per deployment if needed.
SEARCH_API=anthropic
SUMMARIZATION_MODEL=anthropic:claude-sonnet-4-20250514
RESEARCH_MODEL=anthropic:claude-sonnet-4-20250514
COMPRESSION_MODEL=anthropic:claude-sonnet-4-20250514
FINAL_REPORT_MODEL=anthropic:claude-sonnet-4-20250514

# Only necessary for Open Agent Platform
SUPABASE_KEY=
SUPABASE_URL=
# Should be set to true for a production deployment on Open Agent Platform. Should be set to false otherwise, such as for local development.
GET_API_KEYS_FROM_CONFIG=false