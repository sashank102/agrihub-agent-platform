# Copy this file to .env and add a Groq API key for free-tier testing.
GROQ_API_KEY=

# The selected model must support tool calling and structured output.
MODEL=groq:openai/gpt-oss-120b

# DuckDuckGo requires no separate search API key.
SEARCH_API=duckduckgo

# Conservative settings reduce free-tier rate-limit pressure.
MAX_CONCURRENT_RESEARCH_UNITS=2
MAX_RESEARCHER_ITERATIONS=3
MAX_REACT_TOOL_CALLS=5
SUMMARIZATION_MODEL_MAX_TOKENS=4096
RESEARCH_MODEL_MAX_TOKENS=4096
COMPRESSION_MODEL_MAX_TOKENS=4096
FINAL_REPORT_MODEL_MAX_TOKENS=4096

LANGSMITH_TRACING=false
GET_API_KEYS_FROM_CONFIG=false
